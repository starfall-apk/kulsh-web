{
  "version": 2,
  "rewrites": [
    { "source": "/donate", "destination": "/donate/index.html" },
    { "source": "/donate/", "destination": "/donate/index.html" }
  ],
  "headers": [
    {
      "source": "/(fonts|vendor)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
