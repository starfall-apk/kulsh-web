{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/auth/:action/:provider",
      "destination": "/api/auth?action=:action&provider=:provider"
    },
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth?action=:action"
    },
    {
      "source": "/chat",
      "destination": "/chat/index.html"
    },
    {
      "source": "/chat/",
      "destination": "/chat/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/about/",
      "destination": "/about/index.html"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/",
      "destination": "/docs/index.html"
    },
    {
      "source": "/donate",
      "destination": "/donate/index.html"
    },
    {
      "source": "/donate/",
      "destination": "/donate/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(fonts|vendor)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
